<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Design tokens for the Windows app, mirroring the macOS DesignSystem
        (Spacing / Radius / Theme.Colors / TextRole).

        Surfaces stay dark and calm: cards lift with a hairline border instead
        of heavy drop shadows, matching the macOS Card treatment.
    -->

    <!-- Spacing scale: 8pt grid -->
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space6">6</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>

    <!-- Corner radius scale -->
    <CornerRadius x:Key="RadiusS">6</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BrushBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BrushCard" Color="#252525"/>
    <SolidColorBrush x:Key="BrushCardHover" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="BrushField" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#303030"/>
    <SolidColorBrush x:Key="BrushBorderHover" Color="#3D3D3D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#6F6F6F"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="BrushAccent" Color="#4EA1F3"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#2ECC71"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#F4AB3A"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#E74C3C"/>
    <SolidColorBrush x:Key="BrushFavorite" Color="#FFC933"/>

    <!-- Tinted fills for badges/pills (solid color at ~15% alpha) -->
    <SolidColorBrush x:Key="BrushSuccessTint" Color="#262ECC71"/>
    <SolidColorBrush x:Key="BrushWarningTint" Color="#26F4AB3A"/>
    <SolidColorBrush x:Key="BrushDangerTint" Color="#26E74C3C"/>
    <SolidColorBrush x:Key="BrushAccentTint" Color="#264EA1F3"/>

    <!-- Typography: named roles mirroring macOS TextRole -->
    <Style x:Key="TextDisplayTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="TextSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    </Style>

    <Style x:Key="TextFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    </Style>

    <Style x:Key="TextRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="TextRowSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    </Style>

    <Style x:Key="TextPortNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="TextMetadata" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

    <!-- Segoe Fluent Icons glyph. Foreground is intentionally unset so the
         glyph inherits its parent's foreground (e.g. button hover states). -->
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Card: hairline border, no heavy shadow (mirrors macOS Card) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushCardHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Capsule badge/pill (mirrors macOS Badge): shape + padding here,
         tinted Background and colored Foreground are set at the usage site. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

</ResourceDictionary>
