<Window x:Class="PortKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:helpers="clr-namespace:PortKiller.Helpers"
        xmlns:views="clr-namespace:PortKiller.Views"
        xmlns:loc="clr-namespace:PortKiller.Helpers"
        mc:Ignorable="d"
        Title="PortKiller" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Visibility="Visible"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>


        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushCardHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushCardHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Outline Button Style -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushCardHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushTextTertiary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Search TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible ScrollViewer Style (hides scrollbar but keeps scroll functionality) -->
        <Style x:Key="InvisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- System Tray Icon (created in code-behind) -->
    </Window.Resources>

    <!-- Main Container with Transparent Area for Blur -->
    <Border Background="Transparent" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#50000000" BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <!-- Background layer: Solid for right side, transparent for sidebar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Left sidebar area: Transparent for blur -->
                <Border Grid.Column="0" Background="Transparent"/>
                <!-- Right content area: Solid background -->
                <Border Grid.Column="1" Background="{DynamicResource BrushBackground}" CornerRadius="0,16,16,0"/>
            </Grid>
            
            <!-- Content on top of background -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar (Transparent Blur) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- App Title (Draggable) -->
                    <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PortKiller" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Links -->
                    <Border Grid.Row="1" BorderThickness="0,0,1,0" CornerRadius="0,0,0,16" x:Name="SidebarBorder">
                        <Border.Background>
                            <SolidColorBrush Color="#20000000" Opacity="0.5"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#40FFFFFF" Opacity="0.15"/>
                        </Border.BorderBrush>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="12">
                            <StackPanel>
                                <!-- Categories Section -->
                                <TextBlock Text="{loc:Loc sidebar.categories}" Style="{StaticResource TextSectionHeader}" Margin="12,12,0,8"/>
                                <Button Click="SidebarButton_Click" Tag="AllPorts" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.allPorts}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="Favorites" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.favorites}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="Watched" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.watched}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Process Types Section -->
                                <TextBlock Text="{loc:Loc sidebar.processTypes}" Style="{StaticResource TextSectionHeader}" Margin="12,24,0,8"/>
                                <Button Click="SidebarButton_Click" Tag="WebServer" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.webServer}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="Database" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF1AA;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.database}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="Development" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE90F;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.development}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="System" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.system}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="Other" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.other}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cloudflare Tunnels Section -->
                                <TextBlock Text="{loc:Loc sidebar.services}" Style="{StaticResource TextSectionHeader}" Margin="12,24,0,8"/>
                                <Button Click="SidebarButton_Click" Tag="ManagedServices" Style="{StaticResource SidebarButton}"
                                        AutomationProperties.AutomationId="NavLocalServices" AutomationProperties.Name="Local Services">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource BrushAccent}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.localServices}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="SidebarButton_Click" Tag="CloudflareTunnels" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE753;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource BrushWarning}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.cloudflareTunnels}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Settings Section -->
                                <TextBlock Text="{loc:Loc sidebar.settings}" Style="{StaticResource TextSectionHeader}" Margin="12,24,0,8"/>
                                <Button Click="SidebarButton_Click" Tag="Settings" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{loc:Loc sidebar.settingsItem}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Right Content Area (Solid) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar with Search and Controls -->
                    <Border Grid.Row="0" CornerRadius="0,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="{DynamicResource BrushCard}" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search and Actions - Centered (No Icon) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border BorderThickness="0" CornerRadius="20" Padding="0" Background="{DynamicResource BrushSurface}">
                                    <Grid Width="400" Height="36">
                                        <TextBox x:Name="SearchBox" 
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="16,8,16,8"
                                                 FontSize="13"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 CaretBrush="{DynamicResource BrushTextPrimary}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc ports.search.placeholder}" 
                                                   FontSize="13" 
                                                   Foreground="{DynamicResource BrushTextTertiary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="16,0,0,0" 
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Window Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Click="RefreshButton_Click" Style="{StaticResource ModernButton}" Width="40" Height="40" ToolTip="{loc:Loc tooltip.refresh}" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="15" Margin="0,1,0,0"/>
                                </Button>
                                <Button Click="MinimizeButton_Click" Style="{StaticResource ModernButton}" Width="40" Height="40">
                                     <TextBlock Text="—" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/>
                                </Button>
                                <Button Click="MaximizeButton_Click" Style="{StaticResource ModernButton}" Width="40" Height="40">
                                     <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                </Button>
                                <Button Click="CloseButton_Click" Style="{StaticResource ModernButton}" Width="40" Height="40" Margin="8,0,0,0">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Port List with Solid Grey Background -->
                        <Grid Grid.Column="0" x:Name="PortsPanel" Background="{DynamicResource BrushSurface}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Solid Grey Header -->
                            <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="24,16" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
                                <TextBlock x:Name="HeaderText" Text="All Ports" Style="{StaticResource TextDisplayTitle}"/>
                            </Border>

                            <!-- Ports ListView -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="16">
                                <ItemsControl x:Name="PortsListView">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" MouseLeftButtonDown="PortItem_Click" Tag="{Binding}" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status dot -->
                                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource BrushSuccess}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                    <!-- Port number -->
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPort}" Style="{StaticResource TextPortNumber}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64"/>

                                                    <!-- Process info -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource TextRowTitle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Address}"/>
                                                            <Run Text="   •   PID "/>
                                                            <Run Text="{Binding Pid}"/>
                                                            <Run Text="   •   "/>
                                                            <Run Text="{Binding User}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Actions (Kill Button and Spinner) -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Loading Spinner (visible when killing) -->
                                                        <Border Padding="10,6"
                                                                Visibility="{Binding IsKilling, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Grid Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform>
                                                                    <RotateTransform/>
                                                                </Grid.RenderTransform>
                                                                <Ellipse Width="14" Height="14"
                                                                         Stroke="{DynamicResource BrushDanger}"
                                                                         StrokeThickness="2"
                                                                         Opacity="0.3"/>
                                                                <Path Data="M 7,0 A 7,7 0 0 1 14,7"
                                                                      Stroke="{DynamicResource BrushDanger}"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Margin="1"/>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsKilling}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation
                                                                                                Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                                                                                From="0" To="360" Duration="0:0:0.8"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Kill Button (hidden when killing) -->
                                                        <Button
                                                                Click="KillButton_Click"
                                                                Tag="{Binding}"
                                                                Padding="10,6"
                                                                Cursor="Hand"
                                                                ToolTip="{loc:Loc tooltip.kill}"
                                                                Visibility="{Binding IsKilling, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="13"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="#808080"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="6"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background">
                                                                                <Setter.Value>
                                                                                    <SolidColorBrush Color="#40FFFFFF" Opacity="0.1"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel Grid.Row="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" FontSize="56" Foreground="{DynamicResource BrushTextTertiary}" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.4"/>
                                <TextBlock Text="{loc:Loc ports.empty.title}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ports.empty.subtitle}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Status Bar - Solid Grey -->
                            <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="24,10" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
                                <Grid>
                                    <TextBlock x:Name="StatusText" Text="{loc:Loc status.ready}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource BrushSuccessTint}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Loc ports.autoRefresh}" FontSize="11" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Detail Panel - Solid Grey -->
                        <Border Grid.Column="1" x:Name="DetailPanel" Width="320" BorderThickness="1,0,0,0" Padding="24" Visibility="Collapsed" CornerRadius="0,0,16,0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc ports.details.title}" Style="{StaticResource TextTitle}" Margin="0,0,0,20"/>

                                    <!-- Detail Items - Solid Grey -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{loc:Loc ports.column.port}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                        <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                            <TextBlock x:Name="DetailPort" Text="-" Style="{StaticResource TextRowTitle}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{loc:Loc ports.column.process}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                        <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                            <TextBlock x:Name="DetailProcess" Text="-" TextWrapping="Wrap" Style="{StaticResource TextRowTitle}"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{loc:Loc ports.column.pid}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                            <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                                <TextBlock x:Name="DetailPid" Text="-" Style="{StaticResource TextRowTitle}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{loc:Loc ports.column.user}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                            <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                                <TextBlock x:Name="DetailUser" Text="-" Style="{StaticResource TextRowTitle}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{loc:Loc ports.column.address}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                        <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                            <TextBlock x:Name="DetailAddress" Text="-" Style="{StaticResource TextRowTitle}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="{loc:Loc ports.column.command}" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,6"/>
                                        <Border CornerRadius="{StaticResource RadiusM}" Padding="12,8" Background="{DynamicResource BrushField}">
                                            <TextBlock x:Name="DetailCommand" Text="-" TextWrapping="Wrap" Style="{StaticResource TextRowSubtitle}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Buttons - Clean Minimal Outline Style -->
                                    <StackPanel Margin="0,10,0,0">
                                        <Button x:Name="ShareTunnelButton" 
                                                Click="ShareTunnelButton_Click"
                                                Style="{StaticResource OutlineButton}"
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE753;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource BrushWarning}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Share via Tunnel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="FavoriteButton"
                                                Click="FavoriteButton_Click"
                                                Style="{StaticResource OutlineButton}"
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE735;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource BrushFavorite}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{loc:Loc ports.addFavorite}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="WatchButton"
                                                Click="WatchButton_Click"
                                                Style="{StaticResource OutlineButton}"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE890;" Style="{StaticResource IconGlyph}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{loc:Loc ports.watch}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Local Services Panel (Hidden by Default) -->
                    <Grid Grid.Row="1" x:Name="ManagedServicesPanel" Background="{DynamicResource BrushSurface}" Visibility="Collapsed">
                        <views:ManagedServicesView x:Name="ManagedServicesViewControl"/>
                    </Grid>

                    <!-- Settings Panel (Hidden by Default) -->
                    <Grid Grid.Row="1" x:Name="SettingsPanel" Background="{DynamicResource BrushSurface}" Visibility="Collapsed">
                        <views:SettingsView x:Name="SettingsViewControl"/>
                    </Grid>

                    <!-- Cloudflare Tunnels Panel (Hidden by Default) -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="TunnelsPanel" Background="{DynamicResource BrushSurface}" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tunnels Header -->
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="24,16" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE753;" Style="{StaticResource IconGlyph}" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource BrushWarning}"/>
                                    <TextBlock Text="{loc:Loc tunnels.title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Loc tunnels.protocol}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="TunnelProtocolCombo"
                                                  Width="90"
                                                  ItemsSource="{Binding ProtocolOptions}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding CloudflaredProtocol, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  Background="{DynamicResource BrushField}"
                                                  Foreground="{DynamicResource BrushTextPrimary}"
                                                  BorderThickness="0"
                                                  Padding="6,2"/>
                                    </StackPanel>
                                    <Button x:Name="StopAllTunnelsButton" 
                                            Content="{loc:Loc tunnels.stopAll}" 
                                            Click="StopAllTunnels_Click"
                                            Visibility="Collapsed"
                                            Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="12,6"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Click="RefreshTunnels_Click" Style="{StaticResource ModernButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Loc tunnels.refresh}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cloudflared Not Installed Warning -->
                        <Border Grid.Row="1" 
                                x:Name="CloudflaredWarning"
                                Background="{DynamicResource BrushWarningTint}" 
                                BorderBrush="{DynamicResource BrushWarning}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16"
                                Margin="24,16"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚠" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource BrushWarning}"/>
                                    <TextBlock Text="{loc:Loc tunnels.notInstalled}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" Margin="32,0,0,8"
                                           Text="{loc:Loc tunnels.install.instructions}">
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="32,0,0,0" FontFamily="Consolas" FontSize="11">
                                    • Download from: https://github.com/cloudflare/cloudflared/releases
                                    • Or use Chocolatey: choco install cloudflared
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Tunnels List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="16">
                            <ItemsControl x:Name="TunnelsListView">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Indicator -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <Ellipse Width="12" Height="12" 
                                                             Fill="{Binding StatusColor}"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               FontSize="10" 
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Port and URL Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4">
                                                        <Run Text="Port"/>
                                                        <Run Text="{Binding Port}" Foreground="{DynamicResource BrushAccent}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayUrl}" 
                                                               FontSize="13" 
                                                               Foreground="{DynamicResource BrushSuccess}"
                                                               FontFamily="Consolas"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding LastError}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource BrushDanger}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Uptime -->
                                                    <Border Background="{DynamicResource BrushField}" 
                                                            CornerRadius="6" 
                                                            Padding="10,6" 
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            
                                                            <TextBlock Text="{Binding Uptime}" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Copy Button -->
                                                    <Button ToolTip="Copy URL"
                                                            Click="TunnelCopy_Click"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="36" Height="36"
                                                            Padding="6"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="15"/>
                                                    </Button>

                                                    <!-- Open in Browser Button -->
                                                    <Button ToolTip="Open in Browser"
                                                            Click="TunnelOpen_Click"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="36" Height="36"
                                                            Padding="6"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}" FontSize="15"/>
                                                    </Button>

                                                    <!-- Stop Button -->
                                                    <Button ToolTip="Stop Tunnel"
                                                            Click="TunnelStop_Click"
                                                            Tag="{Binding}"
                                                            Width="36" Height="36"
                                                            Padding="6">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushDanger}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Tunnels Empty State -->
                        <StackPanel Grid.Row="1" x:Name="TunnelsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                            <TextBlock Text="&#xE753;" Style="{StaticResource IconGlyph}" FontSize="52" Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.35"/>
                            <TextBlock Text="{loc:Loc tunnels.empty.title}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc tunnels.empty.subtitle}" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource BrushTextSecondary}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,8,0,16"
                                       TextAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource BrushTextTertiary}" 
                                       HorizontalAlignment="Center" 
                                       TextAlignment="Center"
                                       MaxWidth="400">
                                {loc:Loc tunnels.empty.tip}
                            </TextBlock>
                        </StackPanel>

                        <!-- Tunnels Status Bar -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="24,10" Background="#252525" BorderBrush="#353535" CornerRadius="0,0,16,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TunnelStatusDot" Width="6" Height="6" Fill="#808080" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TunnelStatusText" Text="0 active tunnel(s)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="CloudflaredInstalledIndicator" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBlock Text="✓" FontSize="14" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc tunnels.installed}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
