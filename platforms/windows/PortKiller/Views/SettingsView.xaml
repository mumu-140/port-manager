<UserControl x:Class="PortKiller.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PortKiller.Helpers"
             xmlns:models="clr-namespace:PortKiller.Models"
             Background="{DynamicResource BrushSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BrushBorder}"
                Background="{DynamicResource BrushCard}" Padding="24,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="18"
                           Foreground="{DynamicResource BrushAccent}" Margin="0,0,10,0"/>
                <TextBlock Text="{loc:Loc settings.title}" Style="{StaticResource TextDisplayTitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="{loc:Loc settings.section.general}" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Language -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.language.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="170"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding Language}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="{x:Static models:AppLanguage.System}" Content="{loc:Loc settings.language.system}"/>
                                <ComboBoxItem Tag="{x:Static models:AppLanguage.English}" Content="{loc:Loc settings.language.english}"/>
                                <ComboBoxItem Tag="{x:Static models:AppLanguage.SimplifiedChinese}" Content="{loc:Loc settings.language.simplifiedChinese}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Theme -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.theme.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="170"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding Theme}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="{x:Static models:AppTheme.System}" Content="{loc:Loc settings.theme.system}"/>
                                <ComboBoxItem Tag="{x:Static models:AppTheme.Light}" Content="{loc:Loc settings.theme.light}"/>
                                <ComboBoxItem Tag="{x:Static models:AppTheme.Dark}" Content="{loc:Loc settings.theme.dark}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Refresh interval -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.refreshInterval}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.refreshInterval.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding RefreshInterval, UpdateSourceTrigger=LostFocus}"
                                         Width="56" HorizontalContentAlignment="Center"
                                         Background="{DynamicResource BrushField}"
                                         Foreground="{DynamicResource BrushTextPrimary}"
                                         BorderBrush="{DynamicResource BrushBorderHover}"
                                         FontFamily="Consolas" FontSize="13" Padding="6,4"/>
                                <TextBlock Text="{loc:Loc common.sec}" Style="{StaticResource TextCaption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Notifications -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.notifications}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.notifications.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ShowNotifications}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Start with Windows -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.startWithWindows}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.startWithWindows.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoStart}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Hide system processes -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.hideSystemProcesses}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.hideSystemProcesses.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding HideSystemProcesses}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Skip kill confirmation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc settings.skipKillConfirmation}" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="{loc:Loc settings.skipKillConfirmation.subtitle}"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SkipKillConfirmation}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc settings.section.about}" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PortKiller" Style="{StaticResource TextRowTitle}"/>
                        <TextBlock Text="{loc:Loc settings.about.tagline}"
                                   Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
