<UserControl x:Class="PortKiller.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}"
                Background="{StaticResource BrushCard}" Padding="24,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="18"
                           Foreground="{StaticResource BrushAccent}" Margin="0,0,10,0"/>
                <TextBlock Text="Settings" Style="{StaticResource TextDisplayTitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="General" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Refresh interval -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Refresh interval" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="How often the port list updates automatically"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding RefreshInterval, UpdateSourceTrigger=LostFocus}"
                                         Width="56" HorizontalContentAlignment="Center"
                                         Background="{StaticResource BrushField}"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         BorderBrush="{StaticResource BrushBorderHover}"
                                         FontFamily="Consolas" FontSize="13" Padding="6,4"/>
                                <TextBlock Text="sec" Style="{StaticResource TextCaption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Notifications -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Notifications" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="Show a notification when ports change"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ShowNotifications}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

                        <!-- Start with Windows -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource TextRowTitle}"/>
                                <TextBlock Text="Launch PortKiller automatically when you sign in"
                                           Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoStart}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PortKiller" Style="{StaticResource TextRowTitle}"/>
                        <TextBlock Text="Find and kill processes on open ports"
                                   Style="{StaticResource TextRowSubtitle}" Margin="0,2,0,0"/>
                        <TextBlock Text="Version 1.0.0" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
