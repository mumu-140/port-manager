<Window x:Class="PortKiller.Views.ManagedServiceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service profile" Width="520" Height="560" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Type" Foreground="#A0A0A0" FontSize="12"/>
                <ComboBox x:Name="TypeBox" Margin="0,2,0,10" SelectionChanged="Type_SelectionChanged">
                    <ComboBoxItem Content="Custom Service" Tag=""/>
                </ComboBox>

                <!-- Dependency banner (preset mode only) -->
                <Border x:Name="DependencyBanner" Visibility="Collapsed" Padding="8,6" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DependencyBannerText" TextWrapping="Wrap" Foreground="#D0D0D0" FontSize="12"/>
                        <Button x:Name="DependencyDocsButton" Content="View installation docs..." Padding="6,2" Margin="10,0,0,0" FontSize="11" Click="DependencyDocs_Click"/>
                    </StackPanel>
                </Border>

                <!-- Preset summary -->
                <TextBlock x:Name="PresetSummary" Foreground="#909090" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Shared rows: name and port apply to every mode -->
                <TextBlock Text="Name" Foreground="#A0A0A0" FontSize="12"/>
                <TextBox x:Name="NameBox" Margin="0,2,0,10" Padding="6"/>

                <TextBlock Text="Port" Foreground="#A0A0A0" FontSize="12"/>
                <TextBox x:Name="PortBox" Margin="0,2,0,10" Padding="6"/>

                <!-- Preset dynamic fields -->
                <StackPanel x:Name="PresetPanel" Visibility="Collapsed"/>

                <!-- Advanced preset fields -->
                <Expander x:Name="AdvancedPanel" Header="Advanced Options" Foreground="#C0C0C0" Visibility="Collapsed" Margin="0,4,0,0">
                    <StackPanel x:Name="AdvancedFields"/>
                </Expander>

                <!-- Custom-only rows (unchanged behavior) -->
                <StackPanel x:Name="CustomPanel">
                    <TextBlock Text="Host" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBox x:Name="HostBox" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Working directory" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBox x:Name="DirectoryBox" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Start command" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBox x:Name="CommandBox" Margin="0,0,0,6" Padding="6" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                    <TextBlock Text="Use {port} in the command if the command should automatically follow future port edits." Foreground="#808080" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="Commands are stored in plain text. Prefer environment variables over embedding secrets." Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#E06C6C" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
