<UserControl x:Class="PortKiller.Views.ManagedServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PortKiller.Helpers"
             Background="{DynamicResource BrushSurface}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="24,16" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{loc:Loc services.title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc common.refresh}" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc services.add}" Click="Add_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="ServiceList"
                     ItemsSource="{Binding FilteredServices}"
                     SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                     Background="{DynamicResource BrushSurface}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BrushBorder}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Port " Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Port}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrushAccent}" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedService.Name}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding SelectedService.Config.StartCommand}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0">
                        <Run Text="Working directory:"/>
                        <Run Text="{Binding SelectedService.Config.WorkingDirectory}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedService.LastError}" Foreground="{DynamicResource BrushDanger}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{loc:Loc common.start}" Click="Start_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc common.stop}" Click="Stop_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc common.restart}" Click="Restart_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc common.open}" Click="Open_Click" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHttpServicePreset}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Loc common.edit}" Click="Edit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanEdit}"/>
                        <Button Content="{loc:Loc common.delete}" Click="Delete_Click" Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding CanDelete}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc services.networkAccess}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,20,0,0"/>

                    <!-- Local row: formalizes what Open does, with the URL visible -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{loc:Loc services.local}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding HasLocalUrl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding LocalUrl}" FontFamily="Consolas" Foreground="{DynamicResource BrushAccent}" FontSize="12" Margin="10,0,0,0"
                                   Visibility="{Binding HasLocalUrl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{loc:Loc services.noLocalUrl}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLocalUrl}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Temporary public (Quick Tunnel runtime unchanged; HTTP services only) -->
                    <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource BrushAccentTint}" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHttpServicePreset}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc services.tempPublic}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="{loc:Loc services.tempPublic.description}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ServiceTunnelStatusText}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ServiceTunnelUrl}" Foreground="{DynamicResource BrushAccent}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasServiceTunnelUrl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Loc common.share}" Click="Share_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        IsEnabled="{Binding CanShareService}"/>
                                <Button Content="{loc:Loc services.stopTunnel}" Click="StopTunnel_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                        IsEnabled="{Binding CanStopTunnel}"/>
                                <Button Content="{loc:Loc services.copyUrl}" Click="CopyTunnelUrl_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        IsEnabled="{Binding HasServiceTunnelUrl}"/>
                                <Button Content="{loc:Loc services.openTunnel}" Click="OpenTunnelUrl_Click" Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasServiceTunnelUrl}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="12" Background="{DynamicResource BrushDangerTint}" CornerRadius="8"
                            Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc services.portConflict}" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                            <TextBlock Text="{loc:Loc services.portConflict.description}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedService.Conflict.Occupants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource BrushTextPrimary}" FontSize="12">
                                            <Run Text="{Binding Pid}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding ProcessName}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Command}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Loc services.killAndStart}" Click="ResolveConflict_Click" Style="{StaticResource DangerButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc services.recentOutput}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,20,0,8"/>
                    <Border Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="10" MinHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                            <ItemsControl ItemsSource="{Binding SelectedService.RecentOutput}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BrushCard}" Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
