<UserControl x:Class="PortKiller.Views.ManagedServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="24,16" Background="#252525" BorderBrush="#353535">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" Foreground="#4EA1F3"/>
                    <TextBlock Text="Local Services" FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Add Service" Click="Add_Click" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="ServiceList"
                     ItemsSource="{Binding FilteredServices}"
                     SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                     Background="#232323" BorderThickness="0,0,1,0" BorderBrush="#353535">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Port " Foreground="#808080" FontSize="11"/>
                                <TextBlock Text="{Binding Port}" Foreground="#808080" FontSize="11"/>
                                <TextBlock Text="{Binding Status}" Foreground="#4EA1F3" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedService.Name}" FontSize="22" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                    <TextBlock Text="{Binding SelectedService.Config.StartCommand}" FontFamily="Consolas" FontSize="12" Foreground="#A0A0A0" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Foreground="#808080" FontSize="12" Margin="0,4,0,0">
                        <Run Text="Working directory:"/>
                        <Run Text="{Binding SelectedService.Config.WorkingDirectory}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedService.LastError}" Foreground="#E06C6C" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Start" Click="Start_Click" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Stop" Click="Stop_Click" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Restart" Click="Restart_Click" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Open" Click="Open_Click" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Edit" Click="Edit_Click" Padding="16,8" Margin="0,0,8,0"
                                IsEnabled="{Binding CanEdit}"/>
                        <Button Content="Delete" Click="Delete_Click" Padding="16,8"
                                IsEnabled="{Binding CanDelete}"/>
                    </StackPanel>

                    <Border Margin="0,20,0,0" Padding="12" Background="#22302F" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Cloudflare Quick Tunnel" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                            <TextBlock Text="{Binding ServiceTunnelStatusText}" Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ServiceTunnelUrl}" Foreground="#4EA1F3" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasServiceTunnelUrl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Share" Click="Share_Click" Padding="12,6" Margin="0,0,8,0"
                                        IsEnabled="{Binding CanShareService}"/>
                                <Button Content="Stop Tunnel" Click="StopTunnel_Click" Padding="12,6" Margin="0,0,8,0"
                                        IsEnabled="{Binding CanStopTunnel}"/>
                                <Button Content="Copy URL" Click="CopyTunnelUrl_Click" Padding="12,6" Margin="0,0,8,0"
                                        IsEnabled="{Binding HasServiceTunnelUrl}"/>
                                <Button Content="Open Tunnel" Click="OpenTunnelUrl_Click" Padding="12,6"
                                        IsEnabled="{Binding HasServiceTunnelUrl}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="12" Background="#2A2323" CornerRadius="8"
                            Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Port conflict" FontWeight="SemiBold" Foreground="#F4AB3A"/>
                            <TextBlock Text="The configured port is held by a process this session does not own. Killing it requires explicit confirmation." Foreground="#C0C0C0" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedService.Conflict.Occupants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#C0C0C0" FontSize="12">
                                            <Run Text="{Binding Pid}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding ProcessName}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Command}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Kill Occupying Process(es) &amp; Start" Click="ResolveConflict_Click" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent output" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,20,0,8"/>
                    <Border Background="#181818" CornerRadius="8" Padding="10" MinHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                            <ItemsControl ItemsSource="{Binding SelectedService.RecentOutput}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#252525" Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A0A0A0" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
