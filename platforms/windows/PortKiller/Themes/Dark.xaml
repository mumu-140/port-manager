<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: the default PortKiller palette -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BrushBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BrushCard" Color="#252525"/>
    <SolidColorBrush x:Key="BrushCardHover" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="BrushField" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#303030"/>
    <SolidColorBrush x:Key="BrushBorderHover" Color="#3D3D3D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="BrushTextTertiary" Color="#6F6F6F"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="BrushAccent" Color="#4EA1F3"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#2ECC71"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#F4AB3A"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#E74C3C"/>
    <SolidColorBrush x:Key="BrushFavorite" Color="#FFC933"/>

    <!-- Tinted fills for badges/pills (solid color at ~15% alpha) -->
    <SolidColorBrush x:Key="BrushSuccessTint" Color="#262ECC71"/>
    <SolidColorBrush x:Key="BrushWarningTint" Color="#26F4AB3A"/>
    <SolidColorBrush x:Key="BrushDangerTint" Color="#26E74C3C"/>
    <SolidColorBrush x:Key="BrushAccentTint" Color="#264EA1F3"/>

</ResourceDictionary>
